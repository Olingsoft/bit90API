<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Signup</title>
    <style>
      body { margin:0; padding:0; font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:#08101f; color:#edf2ff; display:flex; align-items:center; justify-content:center; min-height:100vh }
      .box { width:min(480px,100%); background:rgba(14,26,52,0.95); border:1px solid rgba(255,255,255,0.06); border-radius:16px; padding:28px }
      h1 { margin:0 0 12px; font-size:1.6rem }
      label { display:block; margin-bottom:6px; color:#c5d3f1 }
      input { width:100%; padding:12px 14px; border-radius:10px; margin-bottom:12px; border:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.03); color:#f8fbff }
      button { width:100%; padding:12px 14px; border-radius:10px; background:#4e81ff; color:#fff; font-weight:700; border:none }
      .note { color:#9bb1d4; margin-bottom:12px }
      .error { color:#ff9aa2; margin-bottom:12px }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>Admin Signup</h1>
      <% if (message) { %>
        <div class="error"><%= message %></div>
      <% } %>
      <p class="note">Create an admin account. You must provide the server's admin signup secret.</p>
      <form method="POST" action="/admin/signup">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="text" required />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required />
        <label for="secret">Signup Secret</label>
        <input id="secret" name="secret" type="password" required />
        <button type="submit">Create Admin</button>
      </form>
    </div>
  </body>
</html>
